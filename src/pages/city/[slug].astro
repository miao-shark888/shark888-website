    },
    {
      slug: 'wulanchabu',
      name: '乌兰察布',
      lat: '41.0341',
      lng: '113.1338',
      specialties: ['察哈尔羊肉', '马铃薯', '奶制品', '特产'],
      localCases: [
        { name: '乌兰察布本地商家', result: '特产电商化与数字化升级' }
      ],
      intro: '乌兰察布地处京津冀经济圈，交通便利。我们为乌兰察布的实体商家提供本地化的有赞服务，帮助商家把握京津冀消费市场的机遇。'
    },
    {
      slug: 'bayannaoer',
      name: '巴彦淖尔',
      lat: '40.7432',
      lng: '107.3877',
