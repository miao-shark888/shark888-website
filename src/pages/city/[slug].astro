    },
    {
      slug: 'alashan',
      name: '阿拉善',
      lat: '38.8479',
      lng: '105.7283',
      specialties: ['阿拉善肉苁蓉', '锁阳', '沙漠特产', '奇石'],
      localCases: [
        { name: '阿拉善本地商家', result: '特产电商化与私域运营' }
      ],
      intro: '阿拉善位于内蒙古最西端，以肉苁蓉、锁阳等沙漠特产闻名。我们为阿拉善的特产商家提供有赞小程序商城搭建服务，帮助珍稀特产开拓线上市场。'
    }
  ];

  return cities.map(city => ({
    params: { slug: city.slug },
    props: { city }
  }));
}

const { city } = Astro.props;
const siteUrl = 'https://www.shark888.cn';

const title = `${city.name}有赞服务商_小程序商城_门店数字化_私域运营_内蒙古神客科技`;
const description = `${city.name}有赞官方授权服务商，提供有赞小程序商城搭建、门店数字化升级、会员私域运营服务。免费上门演示，咨询电话15652701682。深耕${city.specialties.join('、')}等行业。`;
const keywords = `${city.name}有赞,有赞服务商,小程序商城,门店数字化,私域运营,有赞代理,${city.specialties.join(',')}`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': '首页', 'item': `${siteUrl}/` },
    { '@type': 'ListItem', 'position': 2, 'name': '服务城市', 'item': `${siteUrl}/city/` },
    { '@type': 'ListItem', 'position': 3, 'name': city.name, 'item': `${siteUrl}/city/${city.slug}/` }
  ]
};

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  'name': `有赞${city.name}服务中心`,
  'description': `有赞官方授权${city.name}服务商，提供小程序商城、门店数字化、私域运营一站式服务`,
  'url': `${siteUrl}/city/${city.slug}/`,
  'telephone': '+86-15652701682',
  'address': {
    '@type': 'PostalAddress',
    'addressLocality': city.name,
    'addressRegion': '内蒙古自治区',
    'addressCountry': 'CN'
  },
  'geo': {
    '@type': 'GeoCoordinates',
    'latitude': city.lat,
    'longitude': city.lng
  },
  'areaServed': { '@type': 'City', 'name': city.name },
  'parentOrganization': { '@id': `${siteUrl}/#organization` }
};

const services = [
  { title: '有赞小程序商城', desc: `为${city.name}商家搭建微信商城、视频号小店，打通抖音、小红书本地生活，实现多平台同步经营。` },
  { title: '门店数字化升级', desc: `智能收银、库存管理、扫码点单、外卖自提、同城配送，帮助${city.name}实体门店实现线上线下一体化。` },
  { title: '会员私域运营', desc: `会员储值、积分、等级体系，企业微信互通，精准营销触达，让${city.name}商家老客户持续复购。` },
  { title: '本地化上门服务', desc: `${city.name}本地团队，免费上门演示、一对一培训、7×12小时售后支持，资料齐全3-7天即可上线。` }
];

const allCities = ['呼和浩特', '包头', '赤峰', '通辽', '鄂尔多斯', '乌兰察布', '巴彦淖尔', '乌海', '兴安盟', '锡林郭勒', '阿拉善'];
---

<Layout title={title} description={description} keywords={keywords} schema={[breadcrumbSchema, localBusinessSchema]} canonical={`/city/${city.slug}/`}>
  <Header />
  <main>
    <section class="page-hero">
      <div class="container">
        <nav aria-label="breadcrumb" class="breadcrumb">
          <ol>
            <li><a href="/">首页</a></li>
            <li><a href="/city/">服务城市</a></li>
            <li>{city.name}</li>
          </ol>
        </nav>
        <h1>{city.name}有赞服务商</h1>
        <p>小程序商城 · 门店数字化 · 私域运营 · 免费上门演示</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="city-intro">
          <h2>{city.name}有赞官方授权服务商</h2>
          <p>{city.intro}</p>
          <p>服务电话：<a href="tel:15652701682">15652701682</a>（同微信） | 免费上门演示</p>
        </div>

        <h3 class="section-subtitle" style="margin-top:48px;margin-bottom:24px;font-size:1.4rem;font-weight:700;text-align:center;">我们在{city.name}提供的服务</h3>
        <div class="card-grid">
          {services.map(s => (
            <div class="card">
              <h4>{s.title}</h4>
              <p>{s.desc}</p>
            </div>
          ))}
        </div>

        <h3 class="section-subtitle" style="margin-top:48px;margin-bottom:24px;font-size:1.4rem;font-weight:700;text-align:center;">{city.name}特色行业</h3>
        <div class="specialty-grid">
          {city.specialties.map(s => (
            <div class="specialty-card">
              <span class="specialty-icon">&#127807;</span>
              <span>{s}</span>
            </div>
          ))}
        </div>

        {city.localCases.length > 0 && (
          <>
            <h3 class="section-subtitle" style="margin-top:48px;margin-bottom:24px;font-size:1.4rem;font-weight:700;text-align:center;">{city.name}本地客户案例</h3>
            <div class="case-grid">
              {city.localCases.map(c => (
                <div class="case-card">
                  <div class="case-name">{c.name}</div>
                  <div class="case-result">{c.result}</div>
                </div>
              ))}
            </div>
          </>
        )}

        <h3 class="section-subtitle" style="margin-top:48px;margin-bottom:24px;font-size:1.4rem;font-weight:700;text-align:center;">为什么选择我们</h3>
        <div class="why-grid">
          <div class="why-item">
            <strong>官方独家授权</strong>
            <p>有赞官方授权的内蒙古地区独家服务商</p>
          </div>
          <div class="why-item">
            <strong>本地化服务</strong>
            <p>{city.name}本地团队，可安排上门服务</p>
          </div>
          <div class="why-item">
            <strong>全流程交付</strong>
            <p>开通—搭建—培训—运营—售后一条龙</p>
          </div>
          <div class="why-item">
            <strong>价格透明</strong>
            <p>无隐形收费，免费咨询报价</p>
          </div>
        </div>

        <div class="nearby-cities">
          <h4>其他服务城市</h4>
          <div class="nearby-list">
            {allCities.filter(c => c !== city.name).map(c => {
              const slugMap: Record<string, string> = {
                '呼和浩特': 'huhehaote', '包头': 'baotou', '赤峰': 'chifeng', '通辽': 'tongliao',
                '鄂尔多斯': 'eerduosi', '乌兰察布': 'wulanchabu', '巴彦淖尔': 'bayannaoer',
                '乌海': 'wuhai', '兴安盟': 'xinganmeng', '锡林郭勒': 'xilinguole', '阿拉善': 'alashan'
              };
              return <a href={`/city/${slugMap[c]}/`}>{c}</a>;
            })}
          </div>
        </div>
      </div>
    </section>

    <section class="cta-section">
      <div class="container">
        <h2>立即获取免费方案</h2>
        <p>拨打 <a href="tel:15652701682">15652701682</a>（同微信），预约{city.name}免费上门演示</p>
        <div class="cta-buttons">
          <a href="tel:15652701682" class="btn">电话咨询</a>
          <a href="/contact/" class="btn btn-secondary">在线咨询</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .page-hero {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    color: white;
    padding: 48px 0 40px;
  }
  .breadcrumb ol {
    display: flex;
    list-style: none;
    gap: 8px;
    font-size: 0.9rem;
    margin-bottom: 16px;
  }
  .breadcrumb a { color: rgba(255,255,255,0.7); }
  .breadcrumb li:not(:last-child)::after {
    content: '>';
    margin-left: 8px;
    color: rgba(255,255,255,0.4);
  }
  .page-hero h1 { font-size: 2.2rem; margin-bottom: 12px; }
  .page-hero p { color: rgba(255,255,255,0.7); }
  
  .section { padding: 64px 0; }
  
  .city-intro {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }
  .city-intro h2 { font-size: 1.8rem; margin-bottom: 16px; }
  .city-intro p { margin-bottom: 12px; line-height: 1.8; }
  .city-intro a { color: var(--primary); font-weight: 600; }
  
  .specialty-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 16px;
  }
  .specialty-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 20px;
    background: var(--bg-light);
    border-radius: var(--radius);
    font-weight: 600;
  }
  .specialty-icon { font-size: 1.5rem; }
  
  .case-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }
  .case-card {
    background: white;
    padding: 20px;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    border-left: 3px solid var(--primary);
  }
  .case-name { font-weight: 700; margin-bottom: 4px; }
  .case-result { font-size: 0.9rem; color: var(--text-light); }
  
  .why-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px;
  }
  .why-item {
    text-align: center;
    padding: 24px;
    background: var(--bg-light);
    border-radius: var(--radius);
  }
  .why-item strong { display: block; margin-bottom: 8px; font-size: 1.1rem; }
  .why-item p { color: var(--text-light); font-size: 0.9rem; }
  
  .nearby-cities {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }
  .nearby-cities h4 { margin-bottom: 16px; }
  .nearby-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .nearby-list a {
    padding: 8px 16px;
    background: var(--bg-light);
    border-radius: var(--radius);
    font-size: 0.9rem;
  }
  .nearby-list a:hover {
    background: var(--primary);
    color: white;
    text-decoration: none;
  }
  
  .cta-section {
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
    color: white;
    padding: 80px 0;
    text-align: center;
  }
  .cta-section h2 { font-size: 2.2rem; margin-bottom: 16px; }
  .cta-section p { font-size: 1.1rem; margin-bottom: 32px; opacity: 0.9; }
  .cta-section a { color: white; text-decoration: underline; }
  .cta-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .cta-section .btn {
    background: white;
    color: var(--primary);
  }
  .cta-section .btn:hover { background: var(--bg-light); }
  .cta-section .btn-secondary {
    background: transparent;
    color: white;
    border-color: white;
  }
  .cta-section .btn-secondary:hover {
    background: white;
    color: var(--primary);
  }
  
  @media (max-width: 768px) {
    .page-hero h1 { font-size: 1.6rem; }
  }
</style>
